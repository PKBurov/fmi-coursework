<?xml version="1.0"?>

<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" 
	xmlns:cd="http://www.myshop.bg/cd#">
		<rdf:Description rdf:about="http://www.myshop.bg/cd/Unchain my heart">
				<cd:artist>Joe Cocker</cd:artist>
				<cd:country> USA </cd:country>
				<cd:company> EMI </cd:company>
				<cd:price> 8.20 </cd:price>
				<cd:year> 1987 </cd:year>
		</rdf:Description>
