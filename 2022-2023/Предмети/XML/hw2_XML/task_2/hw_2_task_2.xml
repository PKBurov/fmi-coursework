<!--
  Първоначално създаваме роот елемента games, като за него трябва да има под-елемент game, след това за под елемента game, създаваме под-елементи
  home-team както и ex-team, yellow и reds, след това създаваме по задания задължителният елемент scora на играта, а след това създаваме под елементите
  home-team, ex-team, score с атрибута me, който има елемент score, yellows който има под-елемент player, аналогично и за reds и накрая, създаваме
  под-елемента player.
-->
<games>
    <game score="1-1">
        <home-team>Roma</home-team>
        <ex-team>Lazio</ex-team>
        <scores>
            <score me="15">
                <player>Klose</player>
            </score>
            <score me="85" type="penalty">
                <player>Tox</player>
            </score>
        </scores>
        <yellows>
            <player>Tox</player>
            <player>Hernanes</player>
        </yellows>
        <reds>
            <player>Kjaer</player>
        </reds>
    </game>
</games>