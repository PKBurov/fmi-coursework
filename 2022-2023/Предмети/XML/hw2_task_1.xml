<?xml version="1.0"?>

<!--
	Започваме с роот елемент shiporder, който има под-елемент orderpreson, orderid, shipto и item (1 or more). 
	Създаваме под-елементите orderpreson, shipto (който трябва да има под-елемти name, adress, city и contry), name, adress, city, coutry, item (който има под-елемнт title, note (none required), quantity, price), title,
	note,quantity & price. Използваме върешно DTD

-->

<!DOCTYPE shiporder[
	<!NOTATION JPG SYSTEM "Pictures/jpeg">
	<!ELEMENT shiporder (orderperson,shipto,item+)>
	<!ATTLIST shiporder orderid CDATA #REQUIRED>
	<!ELEMENT orderperson (#PCDATA)>
	<!ELEMENT shipto (name,address,city,country)>
	<!ELEMENT name (#PCDATA)>
	<!ELEMENT address (#PCDATA)>
	<!ELEMENT city (#PCDATA)>
	<!ELEMENT country (#PCDATA)>
	<!ELEMENT title (#PCDATA)>
	<!ELEMENT note (#PCDATA)>
	<!ELEMENT quantity (#PCDATA)>
	<!ELEMENT item (title,note?,quantity,price)>
	<!ELEMENT price (#PCDATA)>
	<!ENTITY GHV SYSTEM "Pictures/ghv.jpg" NDATA JPG>
]>

<shiporder orderid="889923">
    <orderperson> 
		John Smith
	</orderperson>
	
   <shipto>
       <name>
			Ola Nordmann
		</name>
        <address>
			Langgt 23
		</address>
        <city>
			4000 Stavanger 
		</city>
        <country>
			Norway 
		</country>
   </shipto>
   <item>
        <title>
			Empire Burlesque
		</title>
        <note> 
			Special Edition
		</note>
        <quantity>
			1
		</quantity>
        <price>
			10.90
		</price>
   </item>
   <item>
        <title>
			Hide your heart
		</title>
        <quantity>
			1
		</quantity>
        <price>
			9.90
		</price>
   </item>
   <img photo="ghv"/>
</shiporder>


